# ==============================================================================
# TALOUSMEDIA - YMPÄRISTÖMUUTTUJAT JA API-AVAIMET
# ==============================================================================
# Kaikille API-avaimille on sisäänrakennettu fallback/testitila, joten sivusto
# ja taustaprosessit toimivat heti myös ilman avaimia!
#
# Kun haluat ottaa tuotanto-ominaisuudet käyttöön, kopioi tämä tiedosto nimelle:
#   .env
# ja täytä haluamiesi palveluiden avaimet.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TEKOÄLYMALLI (AI-analyysit pörssitiedotteille)
# Tarvitaan VAIN TOINEN näistä. Jos kumpaakaan ei ole, järjestelmä käyttää
# automaattista analyysipohjaa.
# ------------------------------------------------------------------------------
# Google Gemini (Ilmainen/edullinen: https://aistudio.google.com/)
GEMINI_API_KEY=

# TAI OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=


# ------------------------------------------------------------------------------
# 2. MAKSUT (Stripe Checkout -kuukausitilaukset 4,99 €/kk)
# Tarvitaan vain salainen avain (Secret Key). Client-puolen avainta ei tarvita,
# koska tilausistunto luodaan palvelinpuolella (/api/checkout).
# Jos puuttuu, tilauspainike ohjaa suoraan testisivulle tilaajatilaan.
# Hanki osoitteesta: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 3. KÄYTTÄJÄHALLINTA (Clerk Authentication)
# Valinnainen. Jos puuttuu, sivustolla on toimiva paikallinen testisessio
# (Kirjaudu / Kokeile maksutta).
# Hanki osoitteesta: https://dashboard.clerk.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# ------------------------------------------------------------------------------
# 4. VALINNAISET ULKOISET JULKAISUT (publish.py)
# Tarvitaan VAIN jos haluat peilata artikkeleita ulkoiseen Ghost-blogiin
# tai Substack/Zapier-webhookiin. Next.js-nettisivu ei tarvitse näitä!
# ------------------------------------------------------------------------------
# Ghost CMS Admin API
GHOST_API_URL=
GHOST_ADMIN_API_KEY=

# Webhook (esim. Zapier / Make / Substack)
PUBLISH_WEBHOOK_URL=
PUBLISH_STATUS=draft
